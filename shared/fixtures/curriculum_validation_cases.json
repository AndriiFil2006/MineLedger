{
  "fixture_version": 1,
  "description": "Curriculum validation parity cases executed by both the Java CurriculumLoader (minecraft-mod SharedCurriculumValidationTest) and the Python validator (backend test_curriculum_validation.py). 'edit' cases apply 'ops' to a fresh copy of base_curriculum, then serialize it; 'raw' cases are complete file contents. 'expect' is 'valid' or 'invalid'. python_message / java_message are substrings each implementation's error must contain (java_message is optional).",
  "base_curriculum": "minecraft-mod/src/main/resources/data/mineledger/curriculum/accounting_101.json",
  "path_syntax": "A path is a list of steps: an object key (string), an array index (integer), or {\"id\": X} selecting the array element whose id is X.",
  "operations": {
    "set": "Set the value at path (adds a missing object key).",
    "delete": "Remove the element/key at path.",
    "append": "Append value to the array at path.",
    "remove_value": "Remove the first element equal to value from the array at path."
  },
  "cases": [
    {"name": "control: unmodified bundle", "kind": "edit", "ops": [], "expect": "valid"},
    {"name": "integral float count is an integer", "kind": "edit", "expect": "valid",
     "ops": [{"op": "set", "path": ["concepts", {"id": "payables.cash_payments"}, "required_correct_answers"], "value": 2.0}]},
    {"name": "amount at the 32-character input limit", "kind": "edit", "expect": "valid",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "99999999999999999999999999999.99"}]},
    {"name": "exponent notation amount (BigDecimal grammar)", "kind": "edit", "expect": "valid",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "8E+1"}]},
    {"name": "trailing zeros beyond two decimals strip to a valid amount", "kind": "edit", "expect": "valid",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "80.000"}]},

    {"name": "answer key not an option", "kind": "edit", "expect": "invalid", "python_message": "exactly one correct option", "java_message": "exactly one correct option ID",
     "ops": [{"op": "set", "path": ["questions", {"id": "inventory.shovels"}, "correct_answer_id"], "value": "shovels.missing"}]},
    {"name": "missing question reference", "kind": "edit", "expect": "invalid", "python_message": "missing reference payables.nope", "java_message": "missing reference payables.nope",
     "ops": [{"op": "set", "path": ["concepts", {"id": "payables.cash_payments"}, "question_ids"], "value": ["payables.nope", "payables.books_partial", "payables.two_invoices"]}]},
    {"name": "referenced question entity deleted", "kind": "edit", "expect": "invalid", "python_message": "missing reference payables.two_invoices", "java_message": "missing reference payables.two_invoices",
     "ops": [{"op": "delete", "path": ["questions", {"id": "payables.two_invoices"}]}]},
    {"name": "journal question used as a concept question", "kind": "edit", "expect": "invalid", "python_message": "missing reference journal.cash_services", "java_message": "missing reference journal.cash_services",
     "ops": [{"op": "append", "path": ["concepts", {"id": "payables.cash_payments"}, "question_ids"], "value": "journal.cash_services"}]},
    {"name": "unknown question field", "kind": "edit", "expect": "invalid", "python_message": "unknown field hint", "java_message": "unknown field hint",
     "ops": [{"op": "set", "path": ["questions", {"id": "inventory.shovels"}, "hint"], "value": "Inventory!"}]},
    {"name": "unknown root field", "kind": "edit", "expect": "invalid", "python_message": "unknown field generated_questions", "java_message": "unknown field generated_questions",
     "ops": [{"op": "set", "path": ["generated_questions"], "value": []}]},
    {"name": "orphan question", "kind": "edit", "expect": "invalid", "python_message": "Unreferenced question IDs", "java_message": "Unreferenced question IDs",
     "ops": [{"op": "remove_value", "path": ["concepts", {"id": "inventory.purchases_on_credit"}, "question_ids"], "value": "inventory.lanterns_delivery"}]},
    {"name": "undersized bank", "kind": "edit", "expect": "invalid", "python_message": "insufficient distinct question bank", "java_message": "insufficient distinct question bank",
     "ops": [{"op": "set", "path": ["concepts", {"id": "payables.cash_payments"}, "required_correct_answers"], "value": 4}]},
    {"name": "zero required answers", "kind": "edit", "expect": "invalid", "python_message": "insufficient distinct question bank", "java_message": "insufficient distinct question bank",
     "ops": [{"op": "set", "path": ["concepts", {"id": "payables.cash_payments"}, "required_correct_answers"], "value": 0}]},
    {"name": "fractional count", "kind": "edit", "expect": "invalid", "python_message": "must be an integer", "java_message": "must be an integer",
     "ops": [{"op": "set", "path": ["concepts", {"id": "payables.cash_payments"}, "required_correct_answers"], "value": 1.5}]},
    {"name": "boolean count", "kind": "edit", "expect": "invalid", "python_message": "must be an integer", "java_message": "must be an integer",
     "ops": [{"op": "set", "path": ["concepts", {"id": "payables.cash_payments"}, "required_correct_answers"], "value": true}]},
    {"name": "coming soon with concepts", "kind": "edit", "expect": "invalid", "python_message": "uniquely identified concepts", "java_message": "uniquely identified concepts",
     "ops": [{"op": "set", "path": ["assignments", {"id": "inventory_fundamentals"}, "availability"], "value": "coming_soon"}]},
    {"name": "unsupported availability", "kind": "edit", "expect": "invalid", "python_message": "unsupported availability", "java_message": "unsupported availability",
     "ops": [{"op": "set", "path": ["assignments", {"id": "accounting101.accruals"}, "availability"], "value": "hidden"}]},
    {"name": "question parent mismatch", "kind": "edit", "expect": "invalid", "python_message": "concept_id does not match", "java_message": "concept_id does not match",
     "ops": [{"op": "set", "path": ["questions", {"id": "inventory.shovels"}, "concept_id"], "value": "payables.cash_payments"}]},
    {"name": "assignment parent mismatch", "kind": "edit", "expect": "invalid", "python_message": "Invalid unit or assignment parent links", "java_message": "Invalid unit or assignment parent links",
     "ops": [{"op": "set", "path": ["assignments", {"id": "accounting101.trial_balance"}, "parent_unit_id"], "value": "accounting101.fundamentals"}]},
    {"name": "unit without assignments", "kind": "edit", "expect": "invalid", "python_message": "assignment_ids is empty", "java_message": "assignment_ids is empty",
     "ops": [{"op": "set", "path": ["units", {"id": "accounting101.adjusting_entries"}, "assignment_ids"], "value": []}]},
    {"name": "duplicate ID across tables", "kind": "edit", "expect": "invalid", "python_message": "Duplicate entity ID across tables", "java_message": "Duplicate entity ID across tables",
     "ops": [{"op": "set", "path": ["labs", 0, "id"], "value": "accounting101"}]},
    {"name": "reused lesson", "kind": "edit", "expect": "invalid", "python_message": "incorrect or reused lesson reference", "java_message": "incorrect or reused lesson reference",
     "ops": [{"op": "set", "path": ["concepts", {"id": "payables.cash_payments"}, "lesson_id"], "value": "lesson.inventory.purchases_on_credit.perpetual"}]},
    {"name": "lesson without worked examples", "kind": "edit", "expect": "invalid", "python_message": "A lesson needs key rules", "java_message": "A lesson needs key rules",
     "ops": [{"op": "set", "path": ["lessons", 0, "worked_examples"], "value": []}]},
    {"name": "units out of order", "kind": "edit", "expect": "invalid", "python_message": "increasing number order", "java_message": "increasing number order",
     "ops": [{"op": "set", "path": ["units", {"id": "accounting101.fundamentals"}, "order"], "value": 5}]},
    {"name": "normalized duplicate option text", "kind": "edit", "expect": "invalid", "python_message": "four unique options", "java_message": "four unique options",
     "ops": [{"op": "set", "path": ["questions", {"id": "inventory.shovels"}, "answer_options", 0, "text"], "value": "  debit inventory 60;   CREDIT Accounts Payable 60. "}]},
    {"name": "only three options", "kind": "edit", "expect": "invalid", "python_message": "four unique options", "java_message": "four unique options",
     "ops": [{"op": "delete", "path": ["questions", {"id": "inventory.shovels"}, "answer_options", 3]}]},
    {"name": "blank prompt", "kind": "edit", "expect": "invalid", "python_message": "prompt must be nonblank text", "java_message": "prompt must be nonblank text",
     "ops": [{"op": "set", "path": ["questions", {"id": "payables.two_invoices"}, "prompt"], "value": "   "}]},
    {"name": "unsupported question type", "kind": "edit", "expect": "invalid", "python_message": "unsupported type essay", "java_message": "unsupported type essay",
     "ops": [{"op": "set", "path": ["questions", {"id": "payables.two_invoices"}, "type"], "value": "essay"}]},
    {"name": "unknown account", "kind": "edit", "expect": "invalid", "python_message": "unknown account", "java_message": "No enum constant com.mineledger.accounting.Account.SALES_REVENUE",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_credit_account"], "value": "SALES_REVENUE"}]},
    {"name": "three-decimal amount", "kind": "edit", "expect": "invalid", "python_message": "single-debit, single-credit", "java_message": "Invalid single-debit, single-credit question",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "80.005"}]},
    {"name": "amount one character over the input limit", "kind": "edit", "expect": "invalid", "python_message": "single-debit, single-credit", "java_message": "Invalid single-debit, single-credit question",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "999999999999999999999999999999.99"}]},
    {"name": "negative amount", "kind": "edit", "expect": "invalid", "python_message": "single-debit, single-credit", "java_message": "Invalid single-debit, single-credit question",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "-80"}]},
    {"name": "zero amount", "kind": "edit", "expect": "invalid", "python_message": "single-debit, single-credit", "java_message": "Invalid single-debit, single-credit question",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "0.00"}]},
    {"name": "underscore digits are not a Java decimal", "kind": "edit", "expect": "invalid", "python_message": "not a decimal number", "java_message": "is neither a decimal digit number",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "1_000"}]},
    {"name": "padded amount is not a Java decimal", "kind": "edit", "expect": "invalid", "python_message": "not a decimal number", "java_message": "is neither a decimal digit number",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": " 80"}]},
    {"name": "NaN amount is not a Java decimal", "kind": "edit", "expect": "invalid", "python_message": "not a decimal number", "java_message": "is neither a decimal digit number",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_amount"], "value": "NaN"}]},
    {"name": "same debit and credit", "kind": "edit", "expect": "invalid", "python_message": "single-debit, single-credit", "java_message": "Invalid single-debit, single-credit question",
     "ops": [{"op": "set", "path": ["questions", {"id": "journal.cash_services"}, "correct_credit_account"], "value": "CASH"}]},
    {"name": "duplicate selectable account", "kind": "edit", "expect": "invalid", "python_message": "duplicate account in debit_accounts", "java_message": "duplicate account in debit_accounts",
     "ops": [{"op": "append", "path": ["questions", {"id": "journal.cash_services"}, "debit_accounts"], "value": "CASH"}]},
    {"name": "unsupported schema", "kind": "edit", "expect": "invalid", "python_message": "Unsupported curriculum schema_version", "java_message": "Unsupported curriculum schema_version",
     "ops": [{"op": "set", "path": ["schema_version"], "value": 2}]},

    {"name": "raw: duplicate JSON field", "kind": "raw", "expect": "invalid", "python_message": "Duplicate JSON field schema_version", "java_message": "Duplicate JSON field schema_version",
     "text": "{\"schema_version\": 1, \"schema_version\": 1}"},
    {"name": "raw: NaN literal", "kind": "raw", "expect": "invalid", "python_message": "Unsupported JSON value NaN", "java_message": "malformed JSON",
     "text": "{\"schema_version\": NaN}"},
    {"name": "raw: invalid UTF-8", "kind": "raw", "expect": "invalid", "python_message": "not valid UTF-8", "java_message": "Input length = 1",
     "base64": "//57fQ=="},
    {"name": "raw: trailing content", "kind": "raw", "expect": "invalid", "python_message": "Malformed JSON", "java_message": "malformed JSON",
     "text": "{\"schema_version\": 1} []"},
    {"name": "raw: root is not an object", "kind": "raw", "expect": "invalid", "python_message": "root must be a JSON object", "java_message": "Not a JSON Object",
     "text": "[]"},
    {"name": "raw: nesting deeper than 32", "kind": "raw", "expect": "invalid", "python_message": "nesting exceeds", "java_message": "JSON nesting exceeds 32 levels",
     "text": "{\"schema_version\": [[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}"},
    {"name": "raw: empty file", "kind": "raw", "expect": "invalid", "python_message": "Malformed JSON", "java_message": "End of input",
     "text": ""}
  ]
}
