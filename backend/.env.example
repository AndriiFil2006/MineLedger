# MineLedger API settings. These are read from the process environment (no .env loader is bundled).
# The defaults below match docker-compose.yml; set them only if your database differs.
MINELEDGER_DATABASE_URL=postgresql+psycopg://mineledger:mineledger@127.0.0.1:5433/mineledger
MINELEDGER_TEST_DATABASE_URL=postgresql+psycopg://mineledger:mineledger@127.0.0.1:5433/mineledger_test
# Optional: curriculum file to import (defaults to the Minecraft mod's bundled accounting_101.json).
# MINELEDGER_CURRICULUM_PATH=../minecraft-mod/src/main/resources/data/mineledger/curriculum/accounting_101.json

# Authentication (see AUTHENTICATION.md). The backend verifies access tokens from an OpenID Connect provider.
# Leave these unset to run without authentication: public endpoints work, protected ones answer 503.
# None of these values is a secret; the backend holds no client secret, password or signing key.
# MINELEDGER_AUTH_ISSUER=https://your-tenant.example-idp.com/       # must equal the token's "iss" exactly
# MINELEDGER_AUTH_AUDIENCE=https://api.mineledger.example           # the API identifier registered with the provider
# MINELEDGER_AUTH_JWKS_URL=                                         # optional; discovered from the issuer if unset
# MINELEDGER_AUTH_ALGORITHMS=RS256                                  # optional; comma-separated, asymmetric only
